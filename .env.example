# Neon – copy both strings from the Neon console (Connect → Prisma)
# Pooled connection (host contains "-pooler") – used by the Next.js app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/curing?sslmode=require"
# Direct (unpooled) connection – used by Prisma CLI: migrate, seed, studio
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/curing?sslmode=require"

# Seed – first admin user (Google sign-in email)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_NAME=""

# Google sign-in (Auth.js). AUTH_SECRET: run `npx auth secret`
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Only accounts on this domain can sign in
AUTH_ALLOWED_DOMAIN="yourcompany.com"

# Local development only: skip Google sign-in and act as this user
DEV_USER_EMAIL=""
DEV_USER_ROLES="ADMIN,PRODUCTION_HEAD"

# Jobs: /api/jobs/w1..w7 need the header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Public address of the dashboard, used for links in WhatsApp messages
APP_URL="http://localhost:3000"

# WhatsApp through Evolution API. Leave blank to only log messages in the Alert Log.
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
